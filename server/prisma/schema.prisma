generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum MessageRole {
  user
  assistant
}

// -------------------------------------------------------------
// 1. USER & AUTH MODELS
// -------------------------------------------------------------
model User {
  id            String      @id @default(uuid()) @db.Uuid
  fullName      String
  email         String      @unique
  passwordHash  String
  avatarUrl     String?
  role          Role        @default(USER)
  status        UserStatus  @default(ACTIVE)
  currency      String      @default("VND")
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  wallets             Wallet[]
  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  savingGoals         SavingGoal[]
  notifications       Notification[]
  chatSessions        ChatSession[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -------------------------------------------------------------
// 2. FINANCE MODELS (Category, Wallet, Transaction, Budget, SavingGoal)
// -------------------------------------------------------------
model Category {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  icon      String          // Lucide icon name, e.g. "Utensils", "Bus", "Coffee"
  color     String          // Hex or token color
  type      TransactionType
  isDefault Boolean         @default(false)
  userId    String?         @db.Uuid // null = system default category, non-null = user custom
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  balance   Decimal  @default(0.00) @db.Decimal(15, 2)
  icon      String   @default("Wallet")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  categoryId  String          @db.Uuid
  walletId    String          @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  note        String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([categoryId])
  @@index([walletId])
  @@map("transactions")
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  categoryId     String?  @db.Uuid // null = total overall monthly budget
  amount         Decimal  @db.Decimal(15, 2)
  month          Int      // 1-12
  year           Int      // e.g. 2026
  alertThreshold Int      @default(80) // Alert user when expense reaches 80%
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model SavingGoal {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  title         String
  targetAmount  Decimal   @db.Decimal(15, 2)
  currentAmount Decimal   @default(0.00) @db.Decimal(15, 2)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saving_goals")
}

// -------------------------------------------------------------
// 3. NOTIFICATION & SYSTEM MODELS
// -------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid // null = broadcast to all users
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, BUDGET_ALERT, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// -------------------------------------------------------------
// 4. AI CHATBOT MODELS
// -------------------------------------------------------------
model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @default("Phiên tư vấn mới")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// -------------------------------------------------------------
// 5. AUDIT LOG (ADMIN)
// -------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @db.Uuid
  action    String   // e.g. "USER_LOCK", "CATEGORY_UPDATE", "BROADCAST_NOTIFICATION"
  targetId  String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 6. SUPPORT TICKET MODEL
// -------------------------------------------------------------
model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String
  email     String
  topic     String   @default("general")
  message   String   @db.Text
  status    String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("support_tickets")
}
