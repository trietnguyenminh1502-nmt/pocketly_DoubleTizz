# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://pocketly_user:pocketly_secret_2026@localhost:5432/pocketly_db?schema=public"

# PostgreSQL Docker credentials
POSTGRES_USER=pocketly_user
POSTGRES_PASSWORD=pocketly_secret_2026
POSTGRES_DB=pocketly_db
POSTGRES_PORT=5432

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_32_chars_pocketly
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_32_chars_pocketly
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini API (Backend only)
GEMINI_API_KEY=your_gemini_api_key_here
